# Copy to .env and fill in. Used by docker-compose.yml.
POSTGRES_USER=skintriage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=skintriage
JWT_SECRET=change-me
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
ANTHROPIC_API_KEY=
SEED_ON_START=true
# Email: defaults to the bundled Mailpit inbox. For real email set these:
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
